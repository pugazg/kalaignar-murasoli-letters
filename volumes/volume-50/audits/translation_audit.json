      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "இடஒதுக்கீட்டில் நீதிமன்றத்தின் மீது பழி சுமத்துவதா?",
      "english_title": "# 3853. Blaming the Court Over Reservation?"
    },
