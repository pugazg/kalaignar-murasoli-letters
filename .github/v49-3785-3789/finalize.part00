def must_replace(path: str | Path, old: str, new: str) -> None:
    p = Path(path)
    text = p.read_text(encoding='utf-8')
    count = text.count(old)
    if count != 1:
        raise SystemExit(
            f'Expected exactly one match in {p}; found {count} for {old!r}'
        )
    p.write_text(text.replace(old, new), encoding='utf-8')


def ensure_correction(path: str | Path, old: str, new: str) -> None:
    p = Path(path)
    text = p.read_text(encoding='utf-8')
    old_count = text.count(old)
    new_count = text.count(new)
    if old_count == 1:
        p.write_text(text.replace(old, new), encoding='utf-8')
        return
    if old_count == 0 and new_count >= 1:
        return
    raise SystemExit(
        f'Correction state invalid in {p}: old={old_count}, new={new_count}, old text={old!r}'
