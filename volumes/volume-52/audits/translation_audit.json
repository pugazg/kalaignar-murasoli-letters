      "order": 47,
      "chapter_id": "m52-l3962",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "மெட்ரோ, மோனோ ரெயில் திட்டங்கள் - ஒரு விளக்கம்!",
      "english_title": "# 3962. Metro and Monorail Projects: An Explanation!"
    },
    {
      "order": 48,
      "chapter_id": "m52-l3963",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "அரசு அலுவலர்களும், அ.தி.மு.க. அரசும்,",
      "english_title": "# 3963. Government Employees and the AIADMK Government"
    },
    {
      "order": 49,
      "chapter_id": "m52-l3964",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "இந்த ஆட்சிக்குத்தான் எத்தனை பெயர்கள்?",
      "english_title": "# 3964. How Many Names Does This Government Have?"
    },
    {
      "order": 50,
      "chapter_id": "m52-l3965",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "காயப்படுத்தப்படும் நீதி; கட்டாயம் எழுந்து நின்று ஜெயிக்கும்!",
      "english_title": "# 3965. Justice May Be Wounded, but It Will Surely Rise and Triumph!"
