      "chapter_id": "m50-l3847",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "திருச்சி என்றாலே, திருப்புமுனை மாநாடுதானே? (2)",
      "english_title": "# 3847. When One Says Tiruchi, Is It Not a Turning-Point Conference? (2)"
    },
    {
