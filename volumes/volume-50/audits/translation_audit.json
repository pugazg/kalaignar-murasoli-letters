      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "மனிதநேயத் தீர்ப்பு!",
      "english_title": "# 3854. A Humane Judgment!"
    },
    {
      "order": 39,
      "chapter_id": "m50-l3855",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
