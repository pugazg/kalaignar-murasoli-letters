    )


def page_body(page: int) -> str:
    p = Path(f'volumes/volume-49/pages/page-{page:03d}.md')
    text = p.read_text(encoding='utf-8')
    match = re.match(r'^---\n.*?\n---\n(?:\n)?', text, flags=re.S)
    if not match:
        raise SystemExit(f'Front matter not found: {p}')
    return text[match.end():].rstrip()


# Reconstruct and unpack the audited English-translation payload.
payload_path = STAGING / 'payload.b64'
encoded = ''.join(payload_path.read_text(encoding='ascii').split())
archive = base64.b64decode(encoded, validate=True)
work = Path(tempfile.mkdtemp(prefix='v49-3785-3789-'))
archive_path = work / 'batch.tar.gz'
archive_path.write_bytes(archive)
extract_dir = work / 'payload'
extract_dir.mkdir()
with tarfile.open(archive_path, 'r:gz') as tf:
    tf.extractall(extract_dir, filter='data')

