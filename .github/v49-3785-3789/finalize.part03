    tamil = '\n\n'.join(
        f'<!-- Source PDF page {page} -->\n\n{page_body(page)}'
        for page in range(start, end + 1)
    )
    placeholder = '<!-- APPEND_TAMIL_FROM_SOURCE -->'
    if content.count(placeholder) != 1:
        raise SystemExit(f'Expected one Tamil placeholder in {source_path}')
    content = content.replace(placeholder, tamil)
    (out_dir / filename).write_text(content.rstrip() + '\n', encoding='utf-8')

shutil.copy2(
    extract_dir / 'TEXTUAL_FIDELITY_AUDIT_3785_3789.md',
    'volumes/volume-49/translations/en/TEXTUAL_FIDELITY_AUDIT_3785_3789.md',
)

