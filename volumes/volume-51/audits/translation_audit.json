  "files": [
    {
      "order": 1,
      "chapter_id": "m51-l3867",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "நிலைகுலைந்த ஆட்சியில் விலைவாசி நிலவரம்!",
      "english_title": "# 3867. The State of Prices under a Government in Disarray!"
    },
    {
      "order": 2,
      "chapter_id": "m51-l3868",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "பட்டியல் தருகிறேன்; பரப்பிடுக!",
      "english_title": "# 3868. I Give You the List; Spread It Far and Wide!"
    },
    {
      "order": 3,
      "chapter_id": "m51-l3869",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "இப்போதாவது ஒரு கணம் சிந்திப்பீர்களா?",
      "english_title": "# 3869. Will You Pause and Think, at Least Now?"
    },
    {
      "order": 4,
      "chapter_id": "m51-l3870",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "எல்லோருக்கும் தெரிந்த உண்மை!",
      "english_title": "# 3870. A Truth Known to Everyone!"
    },
    {
      "order": 5,
      "chapter_id": "m51-l3871",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "“சலசல”வெனப் பெருகும் சாட்சிய அருவிகள் பாரீர்!",
      "english_title": "# 3871. Behold the Cascades of Evidence Swelling with a Murmur!"
    },
    {
      "order": 6,
      "chapter_id": "m51-l3872",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "பொய் சொல்வது நாங்களா? அல்லது நீங்களா?",
      "english_title": "# 3872. Who Is Telling Lies: Us or You?"
    },
    {
      "order": 7,
      "chapter_id": "m51-l3873",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஒவ்வொருவரும் ஒரு வாக்கு; ஒவ்வொருவராலும் ஒரு வாக்கு!",
      "english_title": "# 3873. One Vote from Each Person; One Vote through Each Person!"
    },
    {
      "order": 8,
      "chapter_id": "m51-l3874",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "கங்கையே சூதகமானால் எங்கே போய் மூழ்குவது?",
      "english_title": "# 3874. If the Ganges Itself Becomes Impure, Where Can One Go to Bathe?"
    },
    {
      "order": 9,
      "chapter_id": "m51-l3875",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "துரோகம் செய்தது யார்? புரிகிறதா இப்போது!",
      "english_title": "# 3875. Who Betrayed Tamil Nadu? Do You Understand Now?"
    },
    {
      "order": 10,
      "chapter_id": "m51-l3876",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "நீதியே! நீ இன்னும் இருக்கின்றாயா?",
      "english_title": "# 3876. Justice! Are You Still Alive?"
    },
    {
      "order": 11,
      "chapter_id": "m51-l3877",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "எச்சரிக்கை தேவை; வெற்றி நமதே!",
      "english_title": "# 3877. Vigilance Is Needed; Victory Is Ours!"
    },
    {
      "order": 12,
      "chapter_id": "m51-l3878",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "சொத்துக் குவிப்பு வழக்கு; ஒரு தொடர்கதை! (1)",
      "english_title": "# 3878. The Disproportionate-Assets Case: A Continuing Story! (1)"
    },
    {
