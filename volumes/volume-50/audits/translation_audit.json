      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "மேயருக்கும், மக்களுக்கும் ஒரு விளக்கம்!",
      "english_title": "# 3846. An Explanation for the Mayor and the People!"
    },
    {
