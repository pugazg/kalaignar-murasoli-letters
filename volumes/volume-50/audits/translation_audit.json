      "chapter_id": "m50-l3849",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "திருச்சி என்றாலே, திருப்புமுனை மாநாடுதானே? (3)",
      "english_title": "# 3849. When One Says Tiruchi, Is It Not a Turning-Point Conference? (3)"
    },
    {
      "order": 34,
      "chapter_id": "m50-l3850",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "அம்மாவின் வார்த்தைகள்; “அம்மா”வுக்கே வெளிச்சம்!",
      "english_title": "# 3850. Amma's Words; Only “Amma” Can Shed Light on Them!"
    },
    {
      "order": 35,
      "chapter_id": "m50-l3851",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "மீனவர் பிரச்சினைக்கு விடிவு ஏற்படுமா?",
      "english_title": "# 3851. Will the Fishermen's Problem See the Light of Dawn?"
    },
