  "files": [
    {
      "order": 1,
      "chapter_id": "m52-l3916",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "மாற்றுத் திறனாளிகளை ஏமாற்றும் அ.தி.மு.க. ஆட்சி!",
      "english_title": "# 3916. The AIADMK Government That Deceives Persons with Disabilities!"
    },
    {
      "order": 2,
      "chapter_id": "m52-l3917",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "கழகப் பொறுப்புக்கு போட்டியிட்டு வெற்றி பெறுகிறவர்களும், வெற்றிவாய்ப்பை இழப்பவர்களும் என்றைக்கும் என் உடன்பிறப்புகள்தான்!",
      "english_title": "# 3917. Those Who Contest for Kazhagam Office and Win, and Those Who Miss the Opportunity to Win, Are Forever My Udanpirappugal!"
    },
    {
      "order": 3,
      "chapter_id": "m52-l3918",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "“தாமதமாகும் நீதி; தடுக்கப்படும் நீதியா?”",
      "english_title": "# 3918. “Justice Delayed; Is It Justice Denied?”"
    },
    {
      "order": 4,
      "chapter_id": "m52-l3919",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "புது வகை ஜனநாயகம் பூத்துக் குலுங்குது; பாரீர்!",
      "english_title": "# 3919. Behold, a New Kind of Democracy in Full Bloom!"
    },
    {
      "order": 5,
      "chapter_id": "m52-l3920",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "உன் வருகையை எதிர்பார்த்துக் காத்திருப்பேன்!",
      "english_title": "# 3920. I Shall Wait, Looking Forward to Your Arrival!"
    },
    {
      "order": 6,
      "chapter_id": "m52-l3921",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "தளர்ச்சிப் பாதையில் தடுமாறும் தமிழக ஆட்சி!",
      "english_title": "# 3921. The Tamil Nadu Government Stumbling Along a Path of Decline!"
    },
    {
      "order": 7,
      "chapter_id": "m52-l3922",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "இனியும் நம்புவதற்கு மக்கள் தயாராக இல்லை!",
      "english_title": "# 3922. The People Are No Longer Prepared to Believe!"
    },
    {
      "order": 8,
      "chapter_id": "m52-l3923",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "வென்றது ஜனநாயகமா? பணநாயகமா?",
      "english_title": "# 3923. What Won: Democracy or Moneyocracy?"
    },
    {
      "order": 9,
      "chapter_id": "m52-l3924",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "பொய்யாகிப் போன “புஸ்வாணத்” திட்டங்கள்!",
      "english_title": "# 3924. Plans That Proved False and Fizzled Out!"
    },
    {
      "order": 10,
      "chapter_id": "m52-l3925",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "நம்மீது பழி கூறுபவருக்கு நாக்கு ஒன்றா? இரண்டா?",
      "english_title": "# 3925. Does the Man Who Accuses Us Have One Tongue or Two?"
    },
    {
      "order": 11,
      "chapter_id": "m52-l3926",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "எத்தனை தொழில்களைத்தான் மூடுவது?",
      "english_title": "# 3926. How Many Industries Can They Keep Shutting Down?"
    },
    {
      "order": 12,
      "chapter_id": "m52-l3927",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஒய்யாரக் கொண்டையாம்; தாழம்பூவாம்! (1)",
      "english_title": "# 3927. An Elegant Hairdo, They Say; Fragrant Screw-Pine Flowers, They Say! (1)"
    },
    {
      "order": 13,
      "chapter_id": "m52-l3928",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஒய்யாரக் கொண்டையாம்; தாழம்பூவாம்! (2)",
      "english_title": "# 3928. An Elegant Hairdo, They Say; Fragrant Screw-Pine Flowers, They Say! (2)"
    },
    {
      "order": 14,
      "chapter_id": "m52-l3929",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஒய்யாரக் கொண்டையாம்; தாழம்பூவாம்! (3)",
      "english_title": "# 3929. An Elegant Hairdo, They Say; Fragrant Screw-Pine Flowers, They Say! (3)"
    },
    {
      "order": 15,
      "chapter_id": "m52-l3930",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஒய்யாரக் கொண்டையாம்; தாழம்பூவாம்! (4)",
      "english_title": "# 3930. An Elegant Hairdo, They Say; Fragrant Screw-Pine Flowers, They Say! (4)"
    },
    {
      "order": 16,
      "chapter_id": "m52-l3931",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஒய்யாரக் கொண்டையாம்; தாழம்பூவாம்! (5)",
      "english_title": "# 3931. An Elegant Hairdo, They Say; Fragrant Screw-Pine Flowers, They Say! (5)"
    },
    {
      "order": 17,
      "chapter_id": "m52-l3932",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஒய்யாரக் கொண்டையாம்; தாழம்பூவாம்! (6)",
      "english_title": "# 3932. An Elegant Hairdo, They Say; Fragrant Screw-Pine Flowers, They Say! (6)"
    },
    {
      "order": 18,
      "chapter_id": "m52-l3933",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "பதவி நிலைத்திடவாவது; பதறி எழுவர்!",
      "english_title": "# 3933. At Least to Keep Their Posts, They Will Spring into Action!"
    },
    {
      "order": 19,
      "chapter_id": "m52-l3934",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "நம்பிக்கைக் கருவூலம்தானே நமது கழகம்!",
      "english_title": "# 3934. Is Our Movement Not a Treasury of Trust!"
    },
    {
      "order": 20,
      "chapter_id": "m52-l3935",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஜனநாயகம் சரிவரச் செயல்பட!",
      "english_title": "# 3935. For Democracy to Function Properly!"
    },
    {
      "order": 21,
      "chapter_id": "m52-l3936",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "கேடு கெட்ட ஆட்சியும், “பஜனை” பாடும் சில ஏடுகளும்!",
      "english_title": "# 3936. A Ruinous Government and a Few Newspapers Singing Its “Bhajans”!"
    },
    {
      "order": 22,
      "chapter_id": "m52-l3937",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "செயல்படுகிற ஆட்சி சீக்கிரம் வருமா?",
      "english_title": "# 3937. Will a Functioning Government Come Soon?"
    },
    {
      "order": 23,
      "chapter_id": "m52-l3938",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "தொடர்ந்து மௌன சாட்சிகளாக இருப்பதா?",
      "english_title": "# 3938. Are We to Remain Silent Witnesses?"
    },
    {
      "order": 24,
      "chapter_id": "m52-l3939",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "இருள் அகலவும், இதயங்கள் மலரவும் இதோ திட்டங்கள்!",
      "english_title": "# 3939. Here Are Plans to Dispel the Darkness and Make Hearts Blossom!"
    },
    {
      "order": 25,
      "chapter_id": "m52-l3940",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஆச்சார்யா தரும் அதிர்ச்சித் தகவல்கள்!",
      "english_title": "# 3940. The Shocking Information Revealed by Acharya!"
    },
    {
      "order": 26,
      "chapter_id": "m52-l3941",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "நல்ல சமயம் இது; நழுவ விடலாமா?",
      "english_title": "# 3941. This Is the Right Moment; Can We Let It Slip Away?"
    },
    {
      "order": 27,
      "chapter_id": "m52-l3942",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "அன்று நடந்தது என்ன? என்ன?",
      "english_title": "# 3942. What Happened That Day? What?"
    },
    {
      "order": 28,
      "chapter_id": "m52-l3943",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "பன்னிருக்கு அழகு, மௌனம் காத்தல்!",
      "english_title": "# 3943. Panneer's Grace Lies in Keeping Silent!"
    },
    {
      "order": 29,
      "chapter_id": "m52-l3944",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "எத்தனை காலம்தான் ஏமாற்றுவார் இந்த நாட்டிலே!",
      "english_title": "# 3944. How Long Will They Keep Deceiving This Country!"
    },
    {
      "order": 30,
      "chapter_id": "m52-l3945",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "எல்லோரின் மனத்திலும் எழுந்துள்ள அய்யப்பாடு!",
      "english_title": "# 3945. The Doubt That Has Arisen in Everyone's Mind!"
    },
    {
      "order": 31,
      "chapter_id": "m52-l3946",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "இடர் பல கடந்து; இந்தத் தொடர் பணியை ஆற்றுவோம் வாரீர்!",
      "english_title": "# 3946. Having Crossed Many Hardships, Come, Let Us Carry On This Continuing Work!"
    },
    {
      "order": 32,
      "chapter_id": "m52-l3947",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "என்றும் வாழும் இந்தக் கழகம்!",
      "english_title": "# 3947. This Movement Will Live Forever!"
    },
    {
      "order": 33,
      "chapter_id": "m52-l3948",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "வெட்கமில்லை; வெட்கமில்லை; யாருக்கும் வெட்கமில்லை!",
      "english_title": "# 3948. No Shame; No Shame; No One Has Any Shame!"
    },
    {
      "order": 34,
      "chapter_id": "m52-l3949",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "தை முதல் நாளே; தமிழர் புத்தாண்டு திருநாள்!",
      "english_title": "# 3949. The First Day of Thai Is the Tamil New Year Festival!"
    },
    {
      "order": 35,
      "chapter_id": "m52-l3950",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "முன்னாள் பிரதமர்களின் உறுதிமொழி காப்பாற்றப்படுமா?",
      "english_title": "# 3950. Will the Assurances of Former Prime Ministers Be Honoured?"
    },
    {
      "order": 36,
      "chapter_id": "m52-l3951",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "அகதிகள் பிரச்சினையில் அ.தி.மு.க. அரசின் பொறுப்பற்ற செயல்!",
      "english_title": "# 3951. The AIADMK Government's Irresponsible Conduct on the Refugee Issue!"
    },
    {
      "order": 37,
      "chapter_id": "m52-l3952",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "நம்பிக்கை வீண் போகலாமா?",
      "english_title": "# 3952. Can This Trust Be Allowed to Go in Vain?"
    },
    {
      "order": 38,
      "chapter_id": "m52-l3953",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "அதிர்ச்சி வைத்தியம் அவசியம் அல்லவா?",
      "english_title": "# 3953. Is Shock Treatment Not Necessary?"
    },
    {
      "order": 39,
      "chapter_id": "m52-l3954",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "நீதித்துறை வழங்கியது பாராட்டுரையா? இடித்துரையா?",
      "english_title": "# 3954. Did the Judiciary Offer Praise or a Rebuke?"
    },
    {
      "order": 40,
      "chapter_id": "m52-l3955",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "பூ சுற்றும் கதை எவ்வளவு நாளைக்கு?",
      "english_title": "# 3955. How Long Can This Tale of Deception Continue?"
    },
    {
      "order": 41,
      "chapter_id": "m52-l3956",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "அ.தி.மு.க. ஆட்சியில் இருட்டு, புரட்டு - அனைத்தும் உண்டு!",
      "english_title": "# 3956. Under AIADMK Rule There Is Darkness, Deception, Everything!"
    },
    {
      "order": 42,
      "chapter_id": "m52-l3957",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "கொள்கை காத்திட குவியட்டும் தேர்தல் நிதி!",
      "english_title": "# 3957. Let Election Funds Gather to Protect Our Principles!"
    },
    {
      "order": 43,
      "chapter_id": "m52-l3958",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "நீதி என்றும் வெல்லும்; நிச்சயமாக வெல்லும்!",
      "english_title": "# 3958. Justice Will Always Triumph; It Will Certainly Triumph!"
    },
    {
      "order": 44,
      "chapter_id": "m52-l3959",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "ஆர்ப்பாட்டப் போர்ப்பாட்டு!",
      "english_title": "# 3959. A Battle Song for the Demonstration!"
    },
    {
      "order": 45,
      "chapter_id": "m52-l3960",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "“நீதியே, நீ இன்னும் இருக்கின்றாயா?”",
      "english_title": "# 3960. “Justice, Are You Still There?”"
    },
    {
      "order": 46,
      "chapter_id": "m52-l3961",
      "source_hash_matches": true,
      "english_section_count": 1,
      "tamil_section_count": 1,
      "translator_note_count": 1,
      "has_udanpirappe_note": true,
      "has_em_dash": false,
      "tamil_reading_title": "கூரை ஏறிக் கோழி பிடிக்க முடியாதவர்கள்!",
      "english_title": "# 3961. Those Who Cannot Climb a Roof and Catch a Hen!"
    },
